{
  "name": "vscode-rvmark",
  "displayName": "rvmark",
  "description": "Syntax highlighting for .rv.md and .rvmark files",
  "version": "0.2.0",
  "publisher": "raf",
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "https://github.com/RFoxtea/rvmark-vscode.git"
  },
  "homepage": "https://github.com/RFoxtea/rvmark-vscode#readme",
  "bugs": {
    "url": "https://github.com/RFoxtea/rvmark-vscode/issues"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./dist/extension.js",
  "scripts": {
    "build": "esbuild extension.js --bundle --platform=node --format=cjs --external:vscode --outfile=dist/extension.js",
    "vscode:prepublish": "npm run build",
    "test": "node test.js"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "commands": [
      {
        "command": "rvmark.continueNumbering",
        "title": "rvmark: Continue numbering"
      },
      {
        "command": "rvmark.indentItem",
        "title": "rvmark: Indent item (deeper)"
      },
      {
        "command": "rvmark.outdentItem",
        "title": "rvmark: Outdent item (shallower)"
      },
      {
        "command": "rvmark.moveNodeUp",
        "title": "rvmark: Move node up"
      },
      {
        "command": "rvmark.moveNodeDown",
        "title": "rvmark: Move node down"
      }
    ],
    "keybindings": [
      {
        "command": "rvmark.continueNumbering",
        "key": "enter",
        "when": "editorTextFocus && editorLangId == rvmark && !suggestWidgetVisible && !parameterHintsVisible && !inSnippetMode"
      },
      {
        "command": "type",
        "args": {
          "text": "\n"
        },
        "key": "shift+enter",
        "when": "editorTextFocus && editorLangId == rvmark"
      },
      {
        "command": "rvmark.indentItem",
        "key": "tab",
        "when": "editorTextFocus && editorLangId == rvmark && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "rvmark.outdentItem",
        "key": "shift+tab",
        "when": "editorTextFocus && editorLangId == rvmark && !suggestWidgetVisible && !inSnippetMode"
      },
      {
        "command": "rvmark.moveNodeUp",
        "key": "alt+up",
        "when": "editorTextFocus && editorLangId == rvmark"
      },
      {
        "command": "rvmark.moveNodeDown",
        "key": "alt+down",
        "when": "editorTextFocus && editorLangId == rvmark"
      }
    ],
    "languages": [
      {
        "id": "rvmark",
        "aliases": [
          "rvmark"
        ],
        "extensions": [
          ".rv.md",
          ".rvmark"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configurationDefaults": {
      "[rvmark]": {
        "editor.detectIndentation": false,
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenTypes": [
      {
        "id": "rvmark-bullet",
        "description": "rvmark bullet"
      },
      {
        "id": "rvmark-punctuation",
        "description": "rvmark punctuation"
      },
      {
        "id": "rvmark-escape",
        "description": "rvmark escape"
      },
      {
        "id": "rvmark-link",
        "description": "rvmark link"
      },
      {
        "id": "rvmark-code",
        "description": "rvmark code"
      },
      {
        "id": "rvmark-strong",
        "description": "rvmark strong"
      },
      {
        "id": "rvmark-emphasis",
        "description": "rvmark emphasis"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "rvmark",
        "scopes": {
          "rvmark-bullet": [
            "punctuation.definition.list.begin.markdown"
          ],
          "rvmark-punctuation": [
            "punctuation"
          ],
          "rvmark-escape": [
            "constant.character.escape"
          ],
          "rvmark-link": [
            "markup.underline.link"
          ],
          "rvmark-code": [
            "markup.inline.raw"
          ],
          "rvmark-strong": [
            "markup.bold"
          ],
          "rvmark-emphasis": [
            "markup.italic"
          ]
        }
      }
    ]
  },
  "devDependencies": {
    "rvmark": "file:../rvmark-engine",
    "@vscode/vsce": "^2.32.0",
    "esbuild": "^0.28.2"
  }
}
