{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "rvmark",
  "scopeName": "source.rvmark",
  "fileTypes": ["rvmark"],
  "patterns": [
    { "include": "#markdown-fence" },
    { "include": "#metadata-line" },
    { "include": "#node-line" }
  ],
  "repository": {

    "markdown-fence": {
      "comment": "Fenced code block — body scoped as markdown prose without re-embedding the markdown grammar",
      "begin": "^([ \\t]*)(`{3,}|~{3,})[^\\n]*$",
      "end": "^([ \\t]*)(`{3,}|~{3,})[ \\t]*$",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.markdown-fence.rvmark" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.markdown-fence.rvmark" }
      },
      "name": "markup.fenced_code.block.markdown"
    },

    "metadata-line": {
      "comment": "Bare param block at start of file — document metadata",
      "begin": "^(\\{(?!/))",
      "end": "(\\})\\s*$",
      "beginCaptures": {
        "1": { "name": "punctuation.definition.params.begin.rvmark" }
      },
      "endCaptures": {
        "1": { "name": "punctuation.definition.params.end.rvmark" }
      },
      "patterns": [
        { "include": "#param-anchor" },
        { "include": "#param-embed" },
        { "include": "#param-type" },
        { "include": "#param-flag" },
        { "include": "#param-kv" },
        { "include": "#param-separator" }
      ]
    },

    "node-line": {
      "comment": "A node declaration",
      "match": "^( *)(?:([a-zA-Z0-9]+)\\.|([*-]))\\s+(.*)",
      "captures": {
        "1": { "name": "punctuation.whitespace.indent.rvmark" },
        "2": { "name": "constant.numeric.rvmark" },
        "3": { "name": "constant.numeric.rvmark" },
        "4": { "patterns": [
          { "include": "#param-block" },
          { "include": "#tag-chip" },
          { "include": "#inline-markup" }
        ]}
      }
    },

    "param-block": {
      "comment": "Parameter block {key: val; flag; #anchor; = type; => ref}",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": { "0": { "name": "punctuation.definition.params.begin.rvmark" } },
      "endCaptures": { "0": { "name": "punctuation.definition.params.end.rvmark" } },
      "patterns": [
        { "include": "#param-anchor" },
        { "include": "#param-embed" },
        { "include": "#param-type" },
        { "include": "#param-flag" },
        { "include": "#param-kv" },
        { "include": "#param-separator" }
      ]
    },

    "param-anchor": {
      "comment": "#slug anchor id",
      "name": "entity.name.tag.anchor.rvmark",
      "match": "#[\\w-]+"
    },

    "param-type": {
      "comment": "= typename — type declaration (not =>)",
      "match": "(=)(?!>)\\s*(\\S+)?",
      "captures": {
        "1": { "name": "keyword.operator.type.rvmark" },
        "2": { "name": "support.type.rvmark" }
      }
    },

    "param-embed": {
      "comment": "=> ref — transclusion",
      "match": "(=>)\\s*([^;{}\\s]+)",
      "captures": {
        "1": { "name": "keyword.operator.embed.rvmark" },
        "2": { "name": "markup.underline.link.rvmark" }
      }
    },

    "param-flag": {
      "comment": "Standalone flag keywords",
      "name": "keyword.control.flag.rvmark",
      "match": "\\b(open|hidden|minor)\\b"
    },

    "param-kv": {
      "comment": "key: value parameter pair",
      "match": "([\\w-]+)(\\s*:\\s*)([^;{}]*)",
      "captures": {
        "1": { "name": "variable.language.param-key.rvmark" },
        "2": { "name": "punctuation.separator.key-value.rvmark" },
        "3": { "name": "string.unquoted.param-value.rvmark" }
      }
    },

    "param-separator": {
      "name": "punctuation.separator.params.rvmark",
      "match": ";"
    },

    "tag-chip": {
      "comment": "[Tag] chip — square brackets NOT followed by ( (to avoid matching Markdown links)",
      "name": "entity.other.attribute-name.tag-chip.rvmark",
      "match": "\\[[^\\]]+\\](?!\\()"
    },

    "inline-markup": {
      "comment": "Inline Markdown in node labels",
      "patterns": [
        {
          "comment": "Bold **text**",
          "match": "(\\*\\*)([^*\\n]+)(\\*\\*)",
          "captures": {
            "1": { "name": "punctuation.definition.bold.rvmark" },
            "2": { "name": "markup.bold.rvmark" },
            "3": { "name": "punctuation.definition.bold.rvmark" }
          }
        },
        {
          "comment": "Italic *text*",
          "match": "(\\*)([^*\\n]+)(\\*)",
          "captures": {
            "1": { "name": "punctuation.definition.italic.rvmark" },
            "2": { "name": "markup.italic.rvmark" },
            "3": { "name": "punctuation.definition.italic.rvmark" }
          }
        },
        {
          "comment": "Inline code `code`",
          "name": "markup.inline.raw.string.rvmark",
          "match": "`[^`\\n]+`"
        },
        {
          "comment": "Inline math $expr$",
          "match": "(\\$)([^$\\n]+)(\\$)",
          "captures": {
            "1": { "name": "punctuation.definition.math.begin.rvmark" },
            "2": { "name": "markup.math.inline.rvmark" },
            "3": { "name": "punctuation.definition.math.end.rvmark" }
          }
        },
        {
          "comment": "Markdown link [text](url)",
          "match": "(\\[)([^\\]\\n]+)(\\])(\\()([^)\\n]+)(\\))",
          "captures": {
            "1": { "name": "punctuation.definition.link.begin.rvmark" },
            "2": { "name": "string.other.link.title.rvmark" },
            "3": { "name": "punctuation.definition.link.end.rvmark" },
            "4": { "name": "punctuation.definition.link.begin.rvmark" },
            "5": { "name": "markup.underline.link.rvmark" },
            "6": { "name": "punctuation.definition.link.end.rvmark" }
          }
        }
      ]
    }
  }
}
